# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Matches the service in docker-compose.yml at the repo root.
MONGO_URI=mongodb://localhost:27017/fullstack_auth

# Required. Minimum 32 characters — validated at boot, no fallback default.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Sliding window: token lifetime and the idle timeout. A token is renewed while
# the user is active (see SESSION_RENEW_WITHIN); after this long idle, it dies.
JWT_EXPIRES_IN=1h

# Hard ceiling on a session regardless of activity, measured from login.
# The session cannot slide past this; it bounds a stolen-but-active token.
SESSION_ABSOLUTE_MAX=8h

# Renew the token when a request arrives with less than this much life left.
SESSION_RENEW_WITHIN=10m

# Exact origin of the frontend dev server. Never "*".
CORS_ORIGIN=http://localhost:5173

# bcrypt work factor. 12 in production; lower it in tests for speed.
BCRYPT_ROUNDS=12
