# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Matches the service in docker-compose.yml at the repo root.
MONGO_URI=mongodb://localhost:27017/fullstack_auth

# Required. Minimum 32 characters — validated at boot, no fallback default.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Access token lifetime. This is the only revocation mechanism we have:
# a discarded or stolen token stays valid until it expires.
JWT_EXPIRES_IN=1h

# Exact origin of the frontend dev server. Never "*".
CORS_ORIGIN=http://localhost:5173

# bcrypt work factor. 12 in production; lower it in tests for speed.
BCRYPT_ROUNDS=12
